# AutoFarm Environment Configuration Template

# Server Configuration
PORT=8080
ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=autofarm
DB_PASSWORD=autofarm_secret
DB_NAME=autofarm_db
DB_SSLMODE=disable

# Authentication & Security
JWT_SECRET=super_secret_jwt_random_key_autofarm_change_in_production
SESSION_EXPIRY_HOURS=72

# Frontend Static Assets (when served by Go backend)
STATIC_DIR=../../apps/web/dist

# External OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
